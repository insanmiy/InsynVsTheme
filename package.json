{
  "name": "insyn-vs-theme",
  "displayName": "InsynVsTheme",
  "description": "A dark VS Code theme with rich blue highlighting.",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "InsynVsTheme",
        "uiTheme": "vs-dark",
        "path": "./themes/InsynVsTheme-color-theme.json"
      }
    ],
    "languages": [
      {
        "id": "skript",
        "aliases": ["Skript", "skript"],
        "extensions": [".sk"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "skript",
        "scopeName": "source.skript",
        "path": "./syntaxes/skript.tmLanguage.json"
      }
    ]
  }
}
