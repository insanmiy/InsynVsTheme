{
  "name": "insyn-vs-theme",
  "displayName": "InsynVsTheme",
  "description": "A blue VS Code theme.",
  "version": "2.1.3",
  "publisher": "insanmiy",
  "author": "Insanmiy",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/insanmiy/InsynVsTheme.git"
  },
  "homepage": "https://github.com/insanmiy/InsynVsTheme#readme",
  "bugs": {
    "url": "https://github.com/insanmiy/InsynVsTheme/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes",
    "Programming Languages"
  ],
  "keywords": [
    "blue",
    "dark",
    "file icons",
    "navy",
    "theme"
  ],
  "galleryBanner": {
    "color": "#030812",
    "theme": "dark"
  },
  "icon": "images/icon.png",
  "pricing": "Free",
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish",
    "validate": "powershell ./scripts/validate-release.ps1"
  },
  "contributes": {
    "commands": [
      {
        "command": "insynvstheme.checkForUpdates",
        "title": "Check For Updates",
        "category": "InsynVsTheme"
      }
    ],
    "themes": [
      {
        "label": "InsynVsTheme",
        "uiTheme": "vs-dark",
        "path": "./themes/InsynVsTheme-color-theme.json"
      },
      {
        "label": "InsynVsTheme Colorful",
        "uiTheme": "vs-dark",
        "path": "./themes/InsynVsTheme-colorful-color-theme.json"
      },
      {
        "label": "InsynVsTheme Colorful V2",
        "uiTheme": "vs-dark",
        "path": "./themes/InsynVsTheme-colorfulV2-color-theme.json"
      },
      {
        "label": "InsynVsTheme V2",
        "uiTheme": "vs-dark",
        "path": "./themes/InsynVsTheme-v2-color-theme.json"
      },
      {
        "label": "InsynVsTheme Light",
        "uiTheme": "vs",
        "path": "./themes/InsynVsTheme-light-color-theme.json"
      },
      {
        "label": "InsynVsTheme Light Colorful",
        "uiTheme": "vs",
        "path": "./themes/InsynVsTheme-light-colorful-color-theme.json"
      },
      {
        "label": "InsynVsTheme Light Colorful V2",
        "uiTheme": "vs",
        "path": "./themes/InsynVsTheme-light-colorfulV2-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "insyn-file-icons",
        "label": "Insyn File Icons",
        "path": "./fileicons/insyn-file-icon-theme.json"
      },
      {
        "id": "insyn-colorful-file-icons",
        "label": "Insyn Colorful Icons",
        "path": "./fileicons/insyn-colorful-file-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "skript",
        "aliases": ["Skript", "skript"],
        "extensions": [".sk"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "skript",
        "scopeName": "source.skript",
        "path": "./syntaxes/skript.tmLanguage.json"
      }
    ]
  }
}
