{
  "name": "IB",
  "displayName": "InsanmiyBlue",
  "description": "This makes vscode black with blue highlighting",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "InsanmiyBlue",
        "uiTheme": "vs-dark",
        "path": "./themes/InsanmiyBlue-color-theme.json"
      }
    ],
    "languages": [
      {
        "id": "skript",
        "aliases": ["Skript", "skript"],
        "extensions": [".sk"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "skript",
        "scopeName": "source.skript",
        "path": "./syntaxes/skript.tmLanguage.json"
      }
    ]
  }
}
