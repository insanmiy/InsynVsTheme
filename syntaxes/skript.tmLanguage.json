{
	"name": "Skript",
	"scopeName": "source.skript",
	"fileTypes": ["sk"],
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#events"
		},
		{
			"include": "#commands"
		},
		{
			"include": "#conditionals"
		},
		{
			"include": "#loops"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#effects"
		},
		{
			"include": "#expressions"
		},
		{
			"include": "#color-codes"
		}
	],
	"repository": {
		"comments": {
			"name": "comment.line.number-sign.skript",
			"begin": "#",
			"end": "$"
		},
		"events": {
			"name": "keyword.control.event.skript",
			"match": "^\\s*on\\s+[a-zA-Z_][a-zA-Z0-9_]*(?:\\s+[a-zA-Z0-9_]+)*\\s*:.*$",
			"captures": {
				"1": {
					"name": "keyword.control.event.skript"
				}
			}
		},
		"commands": {
			"name": "entity.name.function.command.skript",
			"match": "^\\s*command\\s+/[a-zA-Z0-9_]+(?:\\s+<[a-zA-Z0-9_]+(?:=[^>]+)?>)*\\s*:.*$",
			"captures": {
				"1": {
					"name": "entity.name.function.command.skript"
				}
			}
		},
		"conditionals": {
			"name": "keyword.control.conditional.skript",
			"match": "\\b(if|else if|else)\\b"
		},
		"loops": {
			"name": "keyword.control.loop.skript",
			"match": "\\b(loop|while)\\b"
		},
		"variables": {
			"name": "variable.other.skript",
			"patterns": [
				{
					"name": "variable.other.global.skript",
					"match": "\\{[a-zA-Z_][a-zA-Z0-9_]*\\}"
				},
				{
					"name": "variable.other.local.skript",
					"match": "\\{_[a-zA-Z_][a-zA-Z0-9_]*\\}"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.skript",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.skript",
					"match": "\\\\."
				},
				{
					"name": "variable.interpolation.skript",
					"match": "%[^%]*%"
				}
			]
		},
		"numbers": {
			"name": "constant.numeric.skript",
			"match": "\\b\\d+(\\.\\d+)?\\b"
		},
		"keywords": {
			"name": "keyword.other.skript",
			"match": "\\b(trigger|cancel event|set|remove|add|give|take|delete|create|broadcast|message|send|wait|stop|pause|continue|break|return|function|options|import|alias|true|false|null)\\b"
		},
		"effects": {
			"name": "support.function.effect.skript",
			"match": "\\b(create explosion|message|broadcast|send|set|remove|add|give|take|delete|kill|heal|damage|teleport|spawn|drop|clear|close|open|execute|run|trigger|cancel|stop|pause|wait)\\b"
		},
		"expressions": {
			"name": "support.variable.expression.skript",
			"match": "\\b(player|block|entity|location|world|item|inventory|slot|command|argument|loop-block|loop-value|loop-index|loop-entity|loop-player)\\b"
		},
		"color-codes": {
			"patterns": [
				{
					"name": "constant.other.color-code.black.skript",
					"match": "(?<!&)&0"
				},
				{
					"name": "constant.other.color-code.dark-blue.skript",
					"match": "(?<!&)&1"
				},
				{
					"name": "constant.other.color-code.dark-green.skript",
					"match": "(?<!&)&2"
				},
				{
					"name": "constant.other.color-code.dark-aqua.skript",
					"match": "(?<!&)&3"
				},
				{
					"name": "constant.other.color-code.dark-red.skript",
					"match": "(?<!&)&4"
				},
				{
					"name": "constant.other.color-code.dark-purple.skript",
					"match": "(?<!&)&5"
				},
				{
					"name": "constant.other.color-code.gold.skript",
					"match": "(?<!&)&6"
				},
				{
					"name": "constant.other.color-code.gray.skript",
					"match": "(?<!&)&7"
				},
				{
					"name": "constant.other.color-code.dark-gray.skript",
					"match": "(?<!&)&8"
				},
				{
					"name": "constant.other.color-code.blue.skript",
					"match": "(?<!&)&9"
				},
				{
					"name": "constant.other.color-code.green.skript",
					"match": "(?<!&)&a"
				},
				{
					"name": "constant.other.color-code.aqua.skript",
					"match": "(?<!&)&b"
				},
				{
					"name": "constant.other.color-code.red.skript",
					"match": "(?<!&)&c"
				},
				{
					"name": "constant.other.color-code.light-purple.skript",
					"match": "(?<!&)&d"
				},
				{
					"name": "constant.other.color-code.yellow.skript",
					"match": "(?<!&)&e"
				},
				{
					"name": "constant.other.color-code.white.skript",
					"match": "(?<!&)&f"
				},
				{
					"name": "constant.other.format-code.obfuscated.skript",
					"match": "(?<!&)&k"
				},
				{
					"name": "constant.other.format-code.bold.skript",
					"match": "(?<!&)&l"
				},
				{
					"name": "constant.other.format-code.strikethrough.skript",
					"match": "(?<!&)&m"
				},
				{
					"name": "constant.other.format-code.underline.skript",
					"match": "(?<!&)&n"
				},
				{
					"name": "constant.other.format-code.italic.skript",
					"match": "(?<!&)&o"
				},
				{
					"name": "constant.other.format-code.reset.skript",
					"match": "(?<!&)&r"
				}
			]
		}
	}
}
