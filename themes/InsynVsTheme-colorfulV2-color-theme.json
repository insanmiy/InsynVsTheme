  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Doc Comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Plain text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#3845FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#E1FF00"
      }
    },
    {
      "name": "Interfaces (Runnable, Serializable, Event)",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.interface.java",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#11FF00",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#6600FF"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "entity.name.variable",
        "support.variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#00FF9D"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#00B3FF"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FF0000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#FF9500",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D400FF"
      }
    },
    {
      "name": "Booleans and Null",
      "scope": [
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#193EF5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Attributes and properties",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.attribute",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#FF00F7"
      }
    },
    {
      "name": "Annotations",
      "scope": [
        "entity.name.type.annotation",
        "punctuation.definition.annotation",
        "meta.declaration.annotation"
      ],
      "settings": {
        "foreground": "#A600FF"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#FF9500"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#E1FF00",
    "type": {
      "foreground": "#E1FF00",
      "bold": false,
      "italic": false
    },
    "class": {
      "foreground": "#E1FF00",
      "bold": false,
      "italic": false
    },
    "enum": {
      "foreground": "#E1FF00",
      "bold": false,
      "italic": false
    },
    "interface": {
      "foreground": "#11FF00",
      "bold": true,
      "italic": true
    },
    "struct": {
      "foreground": "#E1FF00",
      "bold": false,
      "italic": false
    },
    "parameter": {
      "foreground": "#00B3FF",
      "bold": false,
      "italic": false
    },
    "variable": {
      "foreground": "#00FF9D",
      "bold": false,
      "italic": false
    },
    "property": {
      "foreground": "#FF00F7",
      "bold": false,
      "italic": false
    },
    "function": {
      "foreground": "#6600FF",
      "bold": false,
      "italic": false
    },
    "method": {
      "foreground": "#6600FF",
      "bold": false,
      "italic": false
    },
    "keyword": {
      "foreground": "#3845FF",
      "bold": true,
      "italic": false
    },
    "comment": {
      "foreground": "#FFFFFF",
      "bold": true,
      "italic": false
    },
    "string": {
      "foreground": "#FF0000",
      "bold": true,
      "italic": false
    },
    "number": {
      "foreground": "#D400FF",
      "bold": false,
      "italic": false
    },
    "operator": {
      "foreground": "#FFFFFF",
      "bold": false,
      "italic": false
    }
  }
}
