  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#2F4F72"
      }
    },
    {
      "name": "Plain text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#6187B5"
      }
    },
    {
      "name": "Skript fallback text",
      "scope": [
        "source.skript"
      ],
      "settings": {
        "foreground": "#6187B5"
      }
    },
    {
      "name": "Names and declarations",
      "scope": [
        "entity.name",
        "entity.other.inherited-class",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#5085BC"
      }
    },
    {
      "name": "Language support",
      "scope": [
        "support",
        "meta.function",
        "meta.method"
      ],
      "settings": {
        "foreground": "#3A74B8"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#367EC0"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#2866AB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#476B91"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#4C72C4"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "entity.name.variable",
        "support.variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#6187B5"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#2C78A2"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#3FA0CE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#3388BD"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#3B7EC7"
      }
    },
    {
      "name": "Tags and markup",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "markup.heading",
        "markup.deleted",
        "markup.inserted",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#3376BA"
      }
    },
    {
      "name": "Attributes and properties",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#4177BA"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json"
      ],
      "settings": {
        "foreground": "#3B7EC7"
      }
    },
    {
      "name": "Invalid and error text",
      "scope": [
        "invalid",
        "invalid.illegal",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Links",
      "scope": [
        "string.other.link",
        "markup.underline.link",
        "markup.underline"
      ],
      "settings": {
        "foreground": "#3B7EC7",
        "fontStyle": "underline"
      }
    },
