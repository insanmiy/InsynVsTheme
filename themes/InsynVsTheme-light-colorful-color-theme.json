  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#64748B"
      }
    },
    {
      "name": "Plain text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#1E293B"
      }
    },
    {
      "name": "Skript fallback text",
      "scope": [
        "source.skript"
      ],
      "settings": {
        "foreground": "#1E293B"
      }
    },
    {
      "name": "Names and declarations",
      "scope": [
        "entity.name",
        "entity.other.inherited-class",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#EA580C"
      }
    },
    {
      "name": "Language support",
      "scope": [
        "support",
        "meta.function",
        "meta.method"
      ],
      "settings": {
        "foreground": "#0284C7"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#E11D48"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#7C3AED",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#0284C7"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#D97706"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "entity.name.variable",
        "support.variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#1E293B"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#16A34A"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#EA580C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#EA580C"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#0D9488",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags and markup",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "markup.heading",
        "markup.deleted",
        "markup.inserted",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7C3AED"
      }
    },
    {
      "name": "Attributes and properties",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#0284C7"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json"
      ],
      "settings": {
        "foreground": "#7C3AED"
      }
    },
    {
      "name": "Invalid and error text",
      "scope": [
        "invalid",
        "invalid.illegal",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#C5221F",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Links",
      "scope": [
        "string.other.link",
        "markup.underline.link",
        "markup.underline"
      ],
      "settings": {
        "foreground": "#2563EB",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#7C3AED",
    "type": "#0D9488",
    "class": "#0D9488",
    "enum": "#0D9488",
    "interface": "#0891B2",
    "struct": "#0D9488",
    "typeParameter": "#8B5CF6",
    "parameter": "#EA580C",
    "variable": "#1E293B",
    "property": "#0284C7",
    "enumMember": "#EA580C",
    "event": "#E11D48",
    "function": "#D97706",
    "method": "#D97706",
    "macro": "#8B5CF6",
    "label": "#EA580C",
    "regexp": "#E11D48",
    "decorator": "#7C3AED",
    "keyword": {
      "foreground": "#7C3AED",
      "bold": true
    },
    "comment": {
      "foreground": "#64748B",
      "italic": true
    },
    "string": "#16A34A",
    "number": "#EA580C",
    "operator": "#0284C7"
  }
}