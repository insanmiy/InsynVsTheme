  "semanticTokenColors": {
    "namespace": "#0047AB",
    "type": "#00008B",
    "class": "#00008B",
    "enum": "#00008B",
    "interface": "#0047AB",
    "struct": "#00008B",
    "typeParameter": "#1434A4",
    "parameter": "#0047AB",
    "variable": "#0047AB",
    "property": "#1434A4",
    "enumMember": "#0047AB",
    "event": "#1434A4",
    "function": "#1434A4",
    "method": "#1434A4",
    "macro": "#0047AB",
    "label": "#0047AB",
    "regexp": "#1434A4",
    "decorator": "#0047AB",
    "keyword": { "foreground": "#00008B", "bold": true },
    "comment": { "foreground": "#0047AB", "italic": true },
    "string": "#00008B",
    "number": "#0047AB",
    "operator": "#0047AB"
  }
}
