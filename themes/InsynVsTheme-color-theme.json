{
  "name": "InsynVsTheme",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    // Editor
    "editor.background": "#030812",
    "editor.foreground": "#91ABC4",
    "editorCursor.foreground": "#5794D6",
    "editorLineNumber.foreground": "#354D65",
    "editorLineNumber.activeForeground": "#87A8C9",
    "editor.selectionBackground": "#10395F",
    "editor.inactiveSelectionBackground": "#0C2945",
    "editor.selectionHighlightBackground": "#123653AA",
    "editor.wordHighlightBackground": "#12365380",
    "editor.wordHighlightStrongBackground": "#19486F80",
    "editor.findMatchBackground": "#175782",
    "editor.findMatchHighlightBackground": "#103A58",
    "editor.lineHighlightBackground": "#07111D",
    "editorWhitespace.foreground": "#1D344A",
    "editorIndentGuide.background1": "#10263A",
    "editorIndentGuide.activeBackground1": "#2B5E8C",
    "editorBracketMatch.background": "#0D3152",
    "editorBracketMatch.border": "#4B8DCA",
    "editorBracketHighlight.foreground1": "#4D87BF",
    "editorBracketHighlight.foreground2": "#5A95AA",
    "editorBracketHighlight.foreground3": "#667FBB",
    "editorBracketHighlight.foreground4": "#466F9F",
    "editorBracketHighlight.foreground5": "#70A6C4",
    "editorBracketHighlight.foreground6": "#526F91",
    "editorBracketHighlight.unexpectedBracket.foreground": "#F0718B",
    "editorGutter.background": "#030812",

    // Window chrome and navigation
    "titleBar.activeBackground": "#02050B",
    "titleBar.activeForeground": "#CADDF2",
    "titleBar.inactiveBackground": "#02050B",
    "titleBar.inactiveForeground": "#58728B",
    "activityBar.background": "#02050B",
    "activityBar.foreground": "#9ABBDC",
    "activityBar.inactiveForeground": "#4B657C",
    "activityBarBadge.background": "#1D5F9C",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#050C17",
    "sideBar.foreground": "#A9C1D9",
    "sideBar.border": "#0D1D2D",
    "sideBarTitle.foreground": "#CADDF2",
    "sideBarSectionHeader.background": "#081423",
    "sideBarSectionHeader.foreground": "#90ACC8",
    "statusBar.background": "#071E35",
    "statusBar.foreground": "#CFE2F5",
    "statusBar.noFolderBackground": "#061828",
    "statusBar.debuggingBackground": "#10466F",

    // Tabs, panels, and borders
    "editorGroupHeader.tabsBackground": "#040A13",
    "editorGroup.border": "#0D2032",
    "tab.activeBackground": "#07111E",
    "tab.inactiveBackground": "#040B14",
    "tab.activeForeground": "#D0E1F2",
    "tab.inactiveForeground": "#5D768E",
    "tab.activeBorderTop": "#347DBD",
    "tab.border": "#0A1927",
    "panel.background": "#050D18",
    "panel.border": "#122D46",
    "panelTitle.activeForeground": "#CADDF2",
    "panelTitle.inactiveForeground": "#58728B",
    "panelTitle.activeBorder": "#3279B7",
    "focusBorder": "#2B70AD",
    "contrastBorder": "#112B42",

    // Lists, controls, and menus
    "list.activeSelectionBackground": "#0D3152",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#0A2138",
    "list.hoverBackground": "#091B2D",
    "list.highlightForeground": "#579BD4",
    "input.background": "#06111E",
    "input.foreground": "#CADDF2",
    "input.border": "#173750",
    "input.placeholderForeground": "#4F6A82",
    "button.background": "#12558B",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#186AA8",
    "dropdown.background": "#06111E",
    "dropdown.foreground": "#BFD3E7",
    "dropdown.border": "#173750",
    "menu.background": "#050E19",
    "menu.foreground": "#BFD3E7",
    "menu.selectionBackground": "#0D3152",
    "menu.selectionForeground": "#FFFFFF",
    "quickInput.background": "#050E1A",
    "quickInput.foreground": "#CADDF2",
    "quickInputList.focusBackground": "#0D3152",
    "badge.background": "#17598D",
    "badge.foreground": "#FFFFFF",
    "scrollbarSlider.background": "#24476455",
    "scrollbarSlider.hoverBackground": "#315E7D88",
    "scrollbarSlider.activeBackground": "#3A719699",

    // Terminal and notifications
    "terminal.background": "#030812",
    "terminal.foreground": "#BBD0E5",
    "terminal.ansiBlack": "#030812",
    "terminal.ansiRed": "#C76B83",
    "terminal.ansiGreen": "#5FA6A5",
    "terminal.ansiYellow": "#A9A77A",
    "terminal.ansiBlue": "#438DD4",
    "terminal.ansiMagenta": "#7D8AC7",
    "terminal.ansiBrightBlue": "#75B9FF",
    "terminal.ansiCyan": "#52AFC7",
    "terminal.ansiBrightRed": "#E7859D",
    "terminal.ansiBrightGreen": "#7BC8C7",
    "terminal.ansiBrightYellow": "#C9C79B",
    "terminal.ansiBrightMagenta": "#A2ACE6",
    "terminal.ansiBrightCyan": "#82D6E8",
    "terminal.ansiWhite": "#BCD3E8",
    "terminal.ansiBrightWhite": "#F2F8FF",
    "notifications.background": "#06111E",
    "notifications.foreground": "#CADDF2",
    "notifications.border": "#173B57",

    // Source control and diagnostics retain recognizable meaning
    "gitDecoration.addedResourceForeground": "#68B8B1",
    "gitDecoration.modifiedResourceForeground": "#65A9EA",
    "gitDecoration.deletedResourceForeground": "#E87991",
    "gitDecoration.untrackedResourceForeground": "#75C8DA",
    "editorError.foreground": "#F0718B",
    "editorWarning.foreground": "#E5B96E",
    "editorInfo.foreground": "#5FAAF0",
    "editorHint.foreground": "#65BFC4"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "fontStyle": "italic", "foreground": "#6689AD" }
    },
    {
      "name": "Plain text",
      "scope": ["source", "text"],
      "settings": { "foreground": "#91ABC4" }
    },
    {
      "name": "Skript fallback text",
      "scope": ["source.skript"],
      "settings": { "foreground": "#7898B8" }
    },
    {
      "name": "Names and declarations",
      "scope": ["entity.name", "entity.other.inherited-class", "variable.parameter"],
      "settings": { "foreground": "#6F9FCE" }
    },
    {
      "name": "Language support",
      "scope": ["support", "meta.function", "meta.method"],
      "settings": { "foreground": "#668FB8" }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.other.character-class", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#649FB3" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#4F8EDB", "fontStyle": "bold" }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#70A8D0" }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#6EB2E6" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "entity.name.variable", "support.variable", "variable.other"],
      "settings": { "foreground": "#A5C9EC" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#7FABDC" }
    },
    {
      "name": "Escape characters",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#92CADC", "fontStyle": "bold" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#7DC0CF" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "support.type", "support.class", "storage.type.class"],
      "settings": { "foreground": "#819CDE" }
    },
    {
      "name": "Tags and markup",
      "scope": ["entity.name.tag", "meta.tag", "markup.heading", "markup.deleted", "markup.inserted", "markup.changed"],
      "settings": { "foreground": "#5698CE" }
    },
    {
      "name": "Attributes and properties",
      "scope": ["entity.other.attribute-name", "support.type.property-name", "meta.attribute"],
      "settings": { "foreground": "#96C2E7" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json", "meta.structure.dictionary.json"],
      "settings": { "foreground": "#699DCC" }
    },
    {
      "name": "Invalid and error text",
      "scope": ["invalid", "invalid.illegal", "markup.deleted.git_gutter"],
      "settings": { "foreground": "#F0718B" }
    },
    {
      "name": "Links",
      "scope": ["string.other.link", "markup.underline.link", "markup.underline"],
      "settings": { "foreground": "#58A8D8", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#7899DA",
    "type": "#819CDE",
    "class": "#819CDE",
    "enum": "#819CDE",
    "interface": "#89A9DF",
    "struct": "#819CDE",
    "typeParameter": "#92B0DC",
    "parameter": "#ACCBE8",
    "variable": "#A5C9EC",
    "property": "#96C2E7",
    "enumMember": "#7DC0CF",
    "event": "#5E9FD4",
    "function": "#6EB2E6",
    "method": "#6EB2E6",
    "macro": "#6198D1",
    "label": "#668FB8",
    "regexp": "#649FB3",
    "decorator": "#7899DA",
    "keyword": { "foreground": "#4F8EDB", "bold": true },
    "comment": { "foreground": "#6689AD", "italic": true },
    "string": "#7FABDC",
    "number": "#7DC0CF",
    "operator": "#70A8D0"
  }
}
