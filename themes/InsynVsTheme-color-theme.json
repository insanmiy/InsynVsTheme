  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "fontStyle": "italic", "foreground": "#607B98" }
    },
    {
      "name": "Plain text",
      "scope": ["source", "text"],
      "settings": { "foreground": "#7898B8" }
    },
    {
      "name": "Skript fallback text",
      "scope": ["source.skript"],
      "settings": { "foreground": "#6885A3" }
    },
    {
      "name": "Names and declarations",
      "scope": ["entity.name", "entity.other.inherited-class", "variable.parameter"],
      "settings": { "foreground": "#597FA6" }
    },
    {
      "name": "Language support",
      "scope": ["support", "meta.function", "meta.method"],
      "settings": { "foreground": "#587B9B" }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.other.character-class", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#537F90" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#3F73B4", "fontStyle": "bold" }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#5683A5" }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#568EB8" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "entity.name.variable", "support.variable", "variable.other"],
      "settings": { "foreground": "#83A3C2" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#6488B0" }
    },
    {
      "name": "Escape characters",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#72A1B2", "fontStyle": "bold" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#6199A7" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "support.type", "support.class", "storage.type.class"],
      "settings": { "foreground": "#657BAD" }
    },
    {
      "name": "Tags and markup",
      "scope": ["entity.name.tag", "meta.tag", "markup.heading", "markup.deleted", "markup.inserted", "markup.changed"],
      "settings": { "foreground": "#4B7FAA" }
    },
    {
      "name": "Attributes and properties",
      "scope": ["entity.other.attribute-name", "support.type.property-name", "meta.attribute"],
      "settings": { "foreground": "#769ABC" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json", "meta.structure.dictionary.json"],
      "settings": { "foreground": "#537EA3" }
    },
    {
      "name": "Invalid and error text",
      "scope": ["invalid", "invalid.illegal", "markup.deleted.git_gutter"],
      "settings": { "foreground": "#B778D1", "fontStyle": "bold underline" }
    },
    {
      "name": "Links",
      "scope": ["string.other.link", "markup.underline.link", "markup.underline"],
      "settings": { "foreground": "#4586AD", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#607AAA",
    "type": "#657BAD",
    "class": "#657BAD",
    "enum": "#657BAD",
    "interface": "#6B83B2",
    "struct": "#657BAD",
    "typeParameter": "#738EAF",
    "parameter": "#89A5C0",
    "variable": "#83A3C2",
    "property": "#769ABC",
    "enumMember": "#6199A7",
    "event": "#4B7FA8",
    "function": "#568EB8",
    "method": "#568EB8",
    "macro": "#4E7AAA",
    "label": "#587B9B",
    "regexp": "#537F90",
    "decorator": "#607AAA",
    "keyword": { "foreground": "#3F73B4", "bold": true },
    "comment": { "foreground": "#607B98", "italic": true },
    "string": "#6488B0",
    "number": "#6199A7",
    "operator": "#5683A5"
  }
}
