  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "fontStyle": "italic", "foreground": "#0047AB" }
    },
    {
      "name": "Plain text",
      "scope": ["source", "text"],
      "settings": { "foreground": "#1434A4" }
    },
    {
      "name": "Skript fallback text",
      "scope": ["source.skript"],
      "settings": { "foreground": "#0047AB" }
    },
    {
      "name": "Names and declarations",
      "scope": ["entity.name", "entity.other.inherited-class", "variable.parameter"],
      "settings": { "foreground": "#00008B" }
    },
    {
      "name": "Language support",
      "scope": ["support", "meta.function", "meta.method"],
      "settings": { "foreground": "#0047AB" }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.other.character-class", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#1434A4" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#00008B", "fontStyle": "bold" }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "meta.delimiter"],
      "settings": { "foreground": "#0047AB" }
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#1434A4" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "entity.name.variable", "support.variable", "variable.other"],
      "settings": { "foreground": "#0047AB" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#00008B" }
    },
    {
      "name": "Escape characters",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#1434A4", "fontStyle": "bold" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#0047AB" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "support.type", "support.class", "storage.type.class"],
      "settings": { "foreground": "#00008B" }
    },
    {
      "name": "Tags and markup",
      "scope": ["entity.name.tag", "meta.tag", "markup.heading", "markup.deleted", "markup.inserted", "markup.changed"],
      "settings": { "foreground": "#1434A4" }
    },
    {
      "name": "Attributes and properties",
      "scope": ["entity.other.attribute-name", "support.type.property-name", "meta.attribute"],
      "settings": { "foreground": "#0047AB" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json", "meta.structure.dictionary.json"],
      "settings": { "foreground": "#00008B" }
    },
    {
      "name": "Invalid and error text",
      "scope": ["invalid", "invalid.illegal", "markup.deleted.git_gutter"],
      "settings": { "foreground": "#8040A0", "fontStyle": "bold underline" }
    },
    {
      "name": "Links",
      "scope": ["string.other.link", "markup.underline.link", "markup.underline"],
      "settings": { "foreground": "#1434A4", "fontStyle": "underline" }
    },
    {
      "name": "Skript color code - black",
      "scope": ["constant.other.color-code.black.skript"],
      "settings": { "foreground": "#000000" }
    },
    {
      "name": "Skript color code - dark blue",
      "scope": ["constant.other.color-code.dark-blue.skript"],
      "settings": { "foreground": "#0000AA" }
    },
    {
      "name": "Skript color code - dark green",
      "scope": ["constant.other.color-code.dark-green.skript"],
      "settings": { "foreground": "#00AA00" }
    },
    {
      "name": "Skript color code - dark aqua",
      "scope": ["constant.other.color-code.dark-aqua.skript"],
      "settings": { "foreground": "#00AAAA" }
    },
    {
      "name": "Skript color code - dark red",
      "scope": ["constant.other.color-code.dark-red.skript"],
      "settings": { "foreground": "#AA0000" }
    },
    {
      "name": "Skript color code - dark purple",
