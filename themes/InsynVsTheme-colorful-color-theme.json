  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7F8CAA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Plain text",
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#C0CAF5"
      }
    },
    {
      "name": "Skript fallback text",
      "scope": [
        "source.skript"
      ],
      "settings": {
        "foreground": "#C0CAF5"
      }
    },
    {
      "name": "Names and declarations",
      "scope": [
        "entity.name",
        "entity.other.inherited-class",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#FF6F00"
      }
    },
    {
      "name": "Language support",
      "scope": [
        "support",
        "meta.function",
        "meta.method"
      ],
      "settings": {
        "foreground": "#7DCFFF"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#F7768E"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#BB9AF7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "entity.name.variable",
        "support.variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#C0CAF5"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9ECE6A"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#FF6F00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FF6F00"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#73DACA"
      }
    },
    {
      "name": "Tags and markup",
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "markup.heading",
        "markup.deleted",
        "markup.inserted",
        "markup.changed"
      ],
      "settings": {
        "foreground": "#F7768E"
      }
    },
    {
      "name": "Attributes and properties",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.json"
      ],
      "settings": {
        "foreground": "#7DCFFF"
      }
    },
    {
      "name": "Invalid and error text",
      "scope": [
        "invalid",
        "invalid.illegal",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#FF5C57",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Links",
      "scope": [
        "string.other.link",
        "markup.underline.link",
        "markup.underline"
      ],
      "settings": {
        "foreground": "#5CCFE6",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#BB9AF7",
    "type": "#73DACA",
    "class": "#73DACA",
    "enum": "#73DACA",
    "interface": "#4FD6BE",
    "struct": "#73DACA",
    "typeParameter": "#C099FF",
    "parameter": "#FF6F00",
    "variable": "#C0CAF5",
    "property": "#7DCFFF",
    "enumMember": "#FF6F00",
    "event": "#F7768E",
    "function": "#FFD166",
    "method": "#FFD166",
    "macro": "#C099FF",
    "label": "#FF6F00",
    "regexp": "#F7768E",
    "decorator": "#BB9AF7",
    "keyword": {
      "foreground": "#BB9AF7",
      "bold": true
    },
    "comment": {
      "foreground": "#7F8CAA",
      "italic": true
    },
    "string": "#9ECE6A",
    "number": "#FF6F00",
    "operator": "#89DDFF"
  }
}
